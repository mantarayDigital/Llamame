# ─── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://llamame.io
NEXT_PUBLIC_APP_DOMAIN=llamame.io
NEXT_PUBLIC_DOCS_URL=docs.llamame.io/api

# ─── Convex (Required) ──────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# ─── Auth Provider ──────────────────────────────────────────────
# Choose one: Clerk, Auth0, or Convex Auth
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# ─── Google (Calendar + Meet) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Microsoft (Outlook) ────────────────────────────────────────
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ─── Zoom ───────────────────────────────────────────────────────
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# ─── Stripe (Payments) ─────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── PayPal (Payments) ─────────────────────────────────────────
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# ─── WhatsApp Business ─────────────────────────────────────────
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ─── Slack ──────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=

# ─── HubSpot CRM ───────────────────────────────────────────────
# HUBSPOT_ACCESS_TOKEN=

# ─── Mailchimp ──────────────────────────────────────────────────
# MAILCHIMP_API_KEY=

# ─── Notion ─────────────────────────────────────────────────────
# NOTION_API_KEY=

# ─── AI (Meeting Briefs, Scheduling Assistant) ──────────────────
# Choose one: OpenAI or Anthropic
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── Email Sending ─────────────────────────────────────────────
# Choose one: Resend, SendGrid, or AWS SES
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# ─── SMS ────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
