# ─── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://llamame.io
NEXT_PUBLIC_APP_DOMAIN=llamame.io
NEXT_PUBLIC_DOCS_URL=docs.llamame.io/api

# ─── Convex (Required) ──────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# ─── Auth (Convex Auth — email/password + Google OAuth) ─────────
# Run `npx @convex-dev/auth` to generate CONVEX_AUTH_PRIVATE_KEY
# and set it on the Convex dashboard.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SITE_URL=http://localhost:3000

# ─── Google (Calendar + Meet) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Microsoft (Outlook) ────────────────────────────────────────
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ─── Zoom ───────────────────────────────────────────────────────
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# ─── Creem (Billing — Merchant of Record) ─────────────────────
# Sign up at creem.io, create products for Pro ($12/mo) and Team ($24/seat/mo)
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_TEST_MODE=true
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_TEAM=

# ─── Stripe (Client Payments — booking fees) ──────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── PayPal (Payments) ─────────────────────────────────────────
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# ─── WhatsApp Business ─────────────────────────────────────────
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ─── Slack ──────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=

# ─── HubSpot CRM ───────────────────────────────────────────────
# HUBSPOT_ACCESS_TOKEN=

# ─── Mailchimp ──────────────────────────────────────────────────
# MAILCHIMP_API_KEY=

# ─── Notion ─────────────────────────────────────────────────────
# NOTION_API_KEY=

# ─── AI (Meeting Briefs, Scheduling Assistant) ──────────────────
# Choose one: OpenAI or Anthropic
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ─── Email Sending ─────────────────────────────────────────────
# Choose one: Resend, SendGrid, or AWS SES
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# ─── SMS ────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
